{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "computed",
        "fixture"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "algorithm_version",
        "sources",
        "assumptions"
      ]
    },
    "period": {
      "type": "object",
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "start_utc",
        "end_utc"
      ]
    },
    "search": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "candidates_tested": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "bounds": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "candidates_tested",
        "bounds"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "min_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_gap_h": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "min_share",
            "max_gap_h",
            "source"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "site_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "relay_count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "by_site": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "contact_share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "longest_gap_h": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "contact_share",
                "longest_gap_h"
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "relay_count",
          "family",
          "by_site"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "origin",
    "provenance",
    "period",
    "search",
    "target",
    "site_ids",
    "candidates"
  ]
}
