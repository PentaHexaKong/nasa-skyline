{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed CLPS DS response contract (not enforced by current Go handler)",
  "type": "object",
  "required": [
    "schema_version",
    "data_state",
    "analysis_id",
    "site",
    "time",
    "conventions",
    "skyline",
    "samples",
    "summary",
    "events",
    "relay",
    "provenance",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "clps-result-v1"
    },
    "data_state": {
      "enum": [
        "fixture",
        "computed",
        "unavailable"
      ]
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "site": {
      "type": "object",
      "required": [
        "id",
        "latitude_deg",
        "longitude_deg_east",
        "observer_height_m",
        "body_fixed_frame"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg_east": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "observer_height_m": {
          "type": "number",
          "minimum": 0
        },
        "body_fixed_frame": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": [
        "start_utc",
        "end_utc",
        "step_seconds"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "step_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "required": [
        "azimuth",
        "angle_unit",
        "time_scale",
        "duration_unit",
        "interval",
        "observer_height_reference",
        "sun_visibility_rule",
        "earth_visibility_rule"
      ],
      "properties": {
        "azimuth": {
          "type": "string",
          "minLength": 1
        },
        "angle_unit": {
          "type": "string",
          "minLength": 1
        },
        "time_scale": {
          "type": "string",
          "minLength": 1
        },
        "duration_unit": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "observer_height_reference": {
          "type": "string",
          "minLength": 1
        },
        "sun_visibility_rule": {
          "type": "string",
          "minLength": 1
        },
        "earth_visibility_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skyline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "azimuth_deg",
          "elevation_deg"
        ],
        "properties": {
          "azimuth_deg": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "elevation_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "additionalProperties": false
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time_utc",
          "sun_azimuth_deg",
          "sun_elevation_deg",
          "earth_azimuth_deg",
          "earth_elevation_deg",
          "sun_visible_disk_fraction",
          "direct_earth_visible",
          "relay_path_visible"
        ],
        "properties": {
          "time_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "sun_azimuth_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "sun_elevation_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "earth_azimuth_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "exclusiveMaximum": 360
          },
          "earth_elevation_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "sun_visible_disk_fraction": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "direct_earth_visible": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "relay_path_visible": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "mean_visible_solar_disk_fraction",
        "sunlit_time_fraction",
        "longest_dark_interval_seconds",
        "direct_earth_visible_fraction",
        "longest_direct_gap_seconds",
        "relay_assisted_visible_fraction",
        "longest_remaining_gap_seconds"
      ],
      "properties": {
        "mean_visible_solar_disk_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "sunlit_time_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "longest_dark_interval_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "direct_earth_visible_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "longest_direct_gap_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "relay_assisted_visible_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "longest_remaining_gap_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "required": [
        "sunset",
        "earthset"
      ],
      "properties": {
        "sunset": {
          "type": "object",
          "required": [
            "status",
            "time_utc",
            "seconds_from_start"
          ],
          "properties": {
            "status": {
              "enum": [
                "predicted",
                "not_within_interval",
                "not_computed",
                "unavailable"
              ]
            },
            "time_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "seconds_from_start": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "predicted"
                  }
                }
              },
              "then": {
                "properties": {
                  "time_utc": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  "seconds_from_start": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "time_utc": {
                    "type": "null"
                  },
                  "seconds_from_start": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "earthset": {
          "type": "object",
          "required": [
            "status",
            "time_utc",
            "seconds_from_start"
          ],
          "properties": {
            "status": {
              "enum": [
                "predicted",
                "not_within_interval",
                "not_computed",
                "unavailable"
              ]
            },
            "time_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "seconds_from_start": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "predicted"
                  }
                }
              },
              "then": {
                "properties": {
                  "time_utc": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  "seconds_from_start": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "time_utc": {
                    "type": "null"
                  },
                  "seconds_from_start": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "relay": {
      "type": "object",
      "required": [
        "scenario_id",
        "configuration_id"
      ],
      "properties": {
        "scenario_id": {
          "enum": [
            "direct_only",
            "one_relay",
            "two_relays",
            "mother_children",
            "rim_node_relay"
          ]
        },
        "configuration_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "algorithm_version",
        "datasets"
      ],
      "properties": {
        "algorithm_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "filename",
              "version_or_sha256",
              "source_url"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "version_or_sha256": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
