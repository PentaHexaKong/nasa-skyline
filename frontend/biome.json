{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!src/routeTree.gen.ts", "!public", "!src/data/generated", "!data", "!.output", "!dist"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
